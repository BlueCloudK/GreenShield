PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/greenshield.db
# Set DATABASE_URL to use Postgres instead of SQLite.
DATABASE_URL=
DATABASE_SSL=true
# For Supabase, use its published root CA while keeping TLS verification enabled.
DATABASE_SSL_CA=./server/db/certs/supabase-root-2021.crt
SECRET_ENCRYPTION_KEY=replace-with-a-long-random-value
INTERNAL_DEMO_TOKEN=replace-with-a-random-internal-token
