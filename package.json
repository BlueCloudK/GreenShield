{
  "name": "greenshield-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cross-env NODE_ENV=development PORT=3000 node --env-file-if-exists=.env --watch server/index.js",
    "dev:full": "concurrently -k \"npm:dev:api\" \"npm:dev\"",
    "dev:payments": "node --env-file=.env.payos.local server/index.js",
    "payments:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.payos.local scripts/check-payment-config.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "preview": "cross-env NODE_ENV=production node server/index.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "demo:record": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@payos/node": "2.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "pg": "8.23.1",
    "nodemailer": "^10.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
