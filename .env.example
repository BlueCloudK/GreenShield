PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/greenshield.db
# Set DATABASE_URL to use Postgres instead of SQLite.
DATABASE_URL=
DATABASE_SSL=true
# For Supabase, use its published root CA while keeping TLS verification enabled.
DATABASE_SSL_CA=./server/db/certs/supabase-root-2021.crt
SECRET_ENCRYPTION_KEY=replace-with-a-long-random-value
INTERNAL_DEMO_TOKEN=replace-with-a-random-internal-token

# Email (Gmail App Password) for OTP verification
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password-here

# PayOS uses the live merchant API, not a sandbox. Keep disabled until approved.
PAYOS_ENABLED=false
PAYOS_PRODUCTION_APPROVED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_PUBLIC_ORIGIN=http://127.0.0.1:5174
# User-approved sample price for integration tests, not the final selling price.
PAYOS_ASSESSMENT_AMOUNT_VND=2000
PAYOS_PRICE_IS_SAMPLE=true
