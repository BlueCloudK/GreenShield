PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/greenshield.db
SECRET_ENCRYPTION_KEY=replace-with-a-long-random-value
INTERNAL_DEMO_TOKEN=replace-with-a-random-internal-token

# Email (Gmail App Password) for OTP verification
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password-here

# PayOS uses the live merchant API, not a sandbox. Keep disabled until approved.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_PUBLIC_ORIGIN=http://127.0.0.1:5174
# Approved assessment quote in integer VND; do not put a sample charge here.
PAYOS_ASSESSMENT_AMOUNT_VND=
